{
  "id": "./",
  "name": "KML/KMZ View",
  "short_name": "KML View",
  "description": "Xem, quản lý ranh giới dự án (KML/KMZ, bản vẽ DWG) trên ảnh vệ tinh — đồng bộ Google Drive.",
  "lang": "vi",
  "start_url": "./?src=pwa",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "categories": ["navigation", "productivity", "utilities"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./?open=1",
      "accept": {
        "application/vnd.google-earth.kml+xml": [".kml"],
        "application/vnd.google-earth.kmz": [".kmz"],
        "image/vnd.dwg": [".dwg"]
      },
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/vnd.google-earth.kml+xml", "application/vnd.google-earth.kmz",
            "image/vnd.dwg", "application/acad", "application/x-acad", "application/x-dwg", "application/dwg",
            "application/zip", "application/xml", "text/xml", "application/octet-stream",
            ".kml", ".kmz", ".dwg"
          ]
        }
      ]
    }
  }
}
